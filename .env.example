# Environment Mode (production / development)
ENVIRONMENT=production

# Strong random secret key for signing JWT tokens (Required in production)
# Generate one using: openssl rand -hex 32
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here_minimum_32_characters

# Database connection URL (PostgreSQL recommended for production, e.g. Supabase, Neon, or Hostinger Postgres)
DATABASE_URL=postgresql://user:password@hostname:5432/databasename

# Server Port
PORT=8000
