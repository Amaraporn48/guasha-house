# Hostinger LiteSpeed / Apache Routing for Python WSGI / Static
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve existing static files directly if they exist
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other requests to WSGI application if passenger is available
    <IfModule mod_passenger.c>
        PassengerAppRoot /home
        PassengerAppType wsgi
        PassengerStartupFile passenger_wsgi.py
    </IfModule>
</IfModule>
